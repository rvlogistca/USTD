# Copy to .env and set the real values for your environment.
PORT=3000
# Must be the RPC endpoint for the network whose chain ID is 4644.
# Do not use a made-up URL. Keep private RPC credentials on the server.
USTD_RPC_URL=
USTD_CHAIN_ID=4644
USTD_CONTRACT_ADDRESS=0x4644E1113FE1a6bA831D85cc4772b3D0c23DE655
# Comma-separated exact browser origins allowed to call the API.
# Example: https://your-domain.example
CORS_ORIGINS=http://localhost:3000
